import { supabase } from "./supabaseClient";

/* ============================================================
   MISS THANI — CATÉGORIES : le fil qui relie inscription, boutique et formation
   ============================================================ */
export const CATEGORIES_DEFAUT = [
  { cle: "onglerie", nom: "Onglerie", emoji: "💅", couleur: "#E5247E", ordre: 1 },
  { cle: "maquillage", nom: "Maquillage", emoji: "💄", couleur: "#9B51E0", ordre: 2 },
  { cle: "tresse", nom: "Tresse Africaine", emoji: "🪢", couleur: "#F2994A", ordre: 3 },
  { cle: "lace", nom: "Lace", emoji: "👩🏾‍🦱", couleur: "#2D9CDB", ordre: 4 },
  { cle: "dreadlocks", nom: "Dreadlocks", emoji: "🧶", couleur: "#27AE60", ordre: 5 },
  { cle: "fleurs", nom: "Bouquet Éternel", emoji: "🌹", couleur: "#EB5757", ordre: 6 },
];

/* Devine la catégorie d'après un nom (programme, produit, formation) quand elle n'est pas renseignée */
export function categorieDe(objet) {
  if (!objet) return null;
  if (objet.categorie && CATEGORIES_DEFAUT.some((c) => c.cle === objet.categorie)) return objet.categorie;
  if (objet.categorie_cle) return objet.categorie_cle;
  const t = String(objet.nom || objet.titre || objet.categorie || "").toLowerCase();
  if (/ongl|nail/.test(t)) return "onglerie";
  if (/maquill|pinceau|make/.test(t)) return "maquillage";
  if (/tress/.test(t)) return "tresse";
  if (/lace|perruque/.test(t)) return "lace";
  if (/dread|lock/.test(t)) return "dreadlocks";
  if (/fleur|bouquet|floral/.test(t)) return "fleurs";
  return null;
}

export async function chargerCategories() {
  try {
    const { data } = await supabase.from("categories").select("*").order("ordre");
    return data && data.length ? data : CATEGORIES_DEFAUT;
  } catch (e) { return CATEGORIES_DEFAUT; }
}

export const infoCategorie = (cle, liste) => (liste || CATEGORIES_DEFAUT).find((c) => c.cle === cle) || null;

/* Les catégories d'une élève : celles des programmes où elle est inscrite */
export const categoriesEleve = (prospects, programmes) =>
  Array.from(new Set((prospects || []).map((pr) => categorieDe((programmes || []).find((p) => p.id === pr.programme_id))).filter(Boolean)));
